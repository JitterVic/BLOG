# Flask
BLOG_SECRET_KEY=change-me-before-deploy
BLOG_HOST=127.0.0.1
BLOG_PORT=5000
BLOG_DEBUG=false
BLOG_COOKIE_SECURE=false
BLOG_SESSION_LIFETIME_SECONDS=28800
BLOG_LOGIN_MAX_ATTEMPTS=5
BLOG_LOGIN_RATE_WINDOW_SECONDS=300

# Admin
BLOG_ADMIN_PASSWORD=admin123456
BLOG_ADMIN_PREFIX=/admin

# Storage
BLOG_DATABASE_PATH=storage/blog.db
BLOG_MAX_UPLOAD_BYTES=10485760
BLOG_MAX_IMAGE_BYTES=5242880
BLOG_MAX_IMAGE_PIXELS=20000000

# Public site origin for absolute URLs in RSS/sitemap/og tags
# Example: https://example.com
BLOG_PUBLIC_BASE_URL=
