# Flask
BLOG_SECRET_KEY=change-me-before-deploy
BLOG_HOST=127.0.0.1
BLOG_PORT=5000
BLOG_DEBUG=false
BLOG_COOKIE_SECURE=false
BLOG_SESSION_LIFETIME_SECONDS=28800
BLOG_LOGIN_MAX_ATTEMPTS=5
BLOG_LOGIN_RATE_WINDOW_SECONDS=300
# 可信反向代理层数：0=忽略 X-Forwarded-For，直接用 remote_addr（仅适用于直连）
# N>=1 时取 X-Forwarded-For 链倒数第 N 段（nginx $proxy_add_x_forwarded_for 追加模式下，1 即为 nginx 写入的真实客户端 IP）
#
# 重要：部署在 nginx 之后但仍保留 0 时，所有请求的 remote_addr 都是 127.0.0.1，
# 登录限流会退化成"全站共用一个桶"——任何人连续输错密码都会把真正的管理员一起锁在门外，
# 审计日志里的客户端 IP 也会全部记成 127.0.0.1。反向代理部署请务必改为 1。
# deploy.sh 在安装 nginx 时会自动写入 1；手工搭建代理时需要自己设置。
BLOG_TRUSTED_PROXY_COUNT=0
# HSTS max-age（秒），0=关闭；仅 BLOG_COOKIE_SECURE=true 时生效
BLOG_HSTS_MAX_AGE=31536000

# Admin (change both before launch)
BLOG_ADMIN_PASSWORD=replace-with-a-strong-password
BLOG_ADMIN_PREFIX=/your-hidden-admin-path

# Storage
BLOG_DATABASE_PATH=storage/blog.db
BLOG_MAX_UPLOAD_BYTES=10485760
BLOG_MAX_IMAGE_BYTES=5242880
BLOG_MAX_IMAGE_PIXELS=20000000

# Public site origin for absolute URLs in RSS/sitemap/og tags
# Example: https://example.com (required for strict launch verification)
# 留空即可：留空时上面的域名只会被跳过（不生成绝对 URL），启动与日常开发都不受影响。
# 只有 scripts/verify.ps1 -StrictLaunch 会要求它非空——该开关会同时置
# BLOG_REQUIRE_PUBLIC_BASE_URL=true，用于上线前的最后一道检查。
# 注意：一旦填了 https:// 开头的域名，就必须同时设 BLOG_COOKIE_SECURE=true，否则启动会被拦。
BLOG_PUBLIC_BASE_URL=
BLOG_REQUIRE_PUBLIC_BASE_URL=false
